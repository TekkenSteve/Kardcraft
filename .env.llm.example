# ============================================================================
# Kardcraft Agent Workflow LLM config
# ============================================================================
# 

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# GoAgent worker / task-orchestrator config
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-openai-api-key
LLM_BASE_URL=https://api.openai.com/v1
GOAGENT_MODEL_REF=gpt-4o

# ============================================================================
# Usage Method:
# ============================================================================
# 1. Fill in the API Keys above
# 2. Restart LLM consumers: docker-compose restart agent-workflow task-orchestrator go-worker
# 3. Or restart everything: docker-compose up -d --force-recreate
# ============================================================================
