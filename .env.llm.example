# ============================================================================
# Kardcraft Agent Workflow LLM config
# ============================================================================
# 

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# GoAgent worker / task-orchestrator config
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-openai-api-key
LLM_BASE_URL=https://api.openai.com/v1
GOAGENT_MODEL_REF=gpt-4o
HYDRA_TOKEN_URL=http://hydra:4444/oauth2/token
HYDRA_INTROSPECTION_URL=http://hydra:4444/admin/oauth2/introspect
HYDRA_EVENT_AUDIENCE=kardcraft.task-events
AGENT_WORKFLOW_OAUTH_CLIENT_ID=agent-workflow
AGENT_WORKFLOW_OAUTH_CLIENT_SECRET=replace-with-an-agent-workflow-client-secret
TASK_ORCHESTRATOR_OAUTH_CLIENT_ID=task-orchestrator
TASK_ORCHESTRATOR_OAUTH_CLIENT_SECRET=replace-with-a-task-orchestrator-client-secret
AGENT_WORKFLOW_BACKEND_NAME=langgraph
AGENT_WORKFLOW_TASK_QUEUE=agent-workflow-queue
AGENT_WORKFLOW_TYPE=kardcraft.agent_workflow.v1
KARDCRAFT_SCHEDULE_CATCHUP_WINDOW=5m
KARDCRAFT_SCHEDULE_DELIVERY_TIMEOUT=30s
KARDCRAFT_SCHEDULE_RETRY_INITIAL_INTERVAL=1s
KARDCRAFT_SCHEDULE_RETRY_MAXIMUM_INTERVAL=1m
KARDCRAFT_SCHEDULE_RETRY_BACKOFF_COEFFICIENT=2
KARDCRAFT_SCHEDULE_RETRY_MAXIMUM_ATTEMPTS=0
TASK_ORCHESTRATOR_BASE_URL=http://task-orchestrator:50050
GOAGENT_ARTIFACT_STORE_BACKEND=s3
GOAGENT_ARTIFACT_S3_BUCKET=agentos-artifacts
GOAGENT_ARTIFACT_S3_REGION=us-east-1
GOAGENT_ARTIFACT_S3_ENDPOINT=http://minio:9000
GOAGENT_ARTIFACT_S3_ACCESS_KEY_ID=minioadmin
GOAGENT_ARTIFACT_S3_SECRET_ACCESS_KEY=minioadmin
GOAGENT_ARTIFACT_S3_FORCE_PATH_STYLE=true

# ============================================================================
# Usage Method:
# ============================================================================
# 1. Fill in the API Keys above
# 2. Restart LLM consumers: docker-compose restart agent-workflow task-orchestrator
# 3. Or restart everything: docker-compose up -d --force-recreate
# ============================================================================
